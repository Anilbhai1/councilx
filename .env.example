# ==============================================================================
# COUNCIL X | THE SYNDICATE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Rename this file to `.env` or configure in your deployment platform (Vercel / Netlify).

# 1. World-Class AI Mastermind LLM Engines (Configure at least one)
# OpenAI GPT-4o (Deep Research Mode & Native JSON Function Calling)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude 3.5 Sonnet
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# DeepSeek V3 (DeepSeek Chat)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Groq Llama 3.3 70B Versatile
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API (gemini-2.0-flash / gemini-1.5-pro)
GEMINI_API_KEY=your_gemini_api_key_here
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# 2. Agentic Real-Time RAG (Live Internet Search Engine)
# Tavily Live Search API (https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# Optional Google Search / Serper
SERPER_API_KEY=your_serper_api_key_here

# 3. Supabase Backend (PostgreSQL & Persistent 100% History Sync)
# Obtain from your Supabase project dashboard -> Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 4. Payment Gateways
# Razorpay Live Key ID (Public - used on frontend): rzp_live_xxxxxxxx
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_live_Tqty6gwfEY7eqC
RAZORPAY_KEY_ID=rzp_live_Tqty6gwfEY7eqC
# Stripe (Global): pk_test_xxxxxxxx or pk_live_xxxxxxxx
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_CouncilXStripeKey123

# Razorpay Secret (Backend / Serverless Functions only)
# Strictly used by serverless verification functions. NEVER prefix with EXPO_PUBLIC_!
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# 5. App Mode ('production' or 'development')
EXPO_PUBLIC_APP_ENV=development
