# ==============================================================================
# COUNCIL X | THE SYNDICATE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Rename this file to `.env` or set these in your hosting environment.

# 1. Google Gemini API (Required for AI responses)
# Obtain your free API key at: https://aistudio.google.com/
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase Backend (Optional: local AsyncStorage fallback works automatically)
# Obtain from your Supabase project dashboard -> Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 3. Payment Gateways
# Razorpay Live Key ID (Public - used on frontend): rzp_live_xxxxxxxx
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_live_Tqty6gwfEY7eqC
RAZORPAY_KEY_ID=rzp_live_Tqty6gwfEY7eqC
# Stripe (Global): pk_test_xxxxxxxx or pk_live_xxxxxxxx
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_CouncilXStripeKey123

# Razorpay Secret (Backend / Serverless Functions only)
# Strictly used by serverless verification functions. NEVER prefix with EXPO_PUBLIC_!
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# 4. App Mode ('production' or 'development')
EXPO_PUBLIC_APP_ENV=development
